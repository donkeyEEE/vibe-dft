{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema.json",
  "title": "PR Introduction masked-continuation dataset",
  "type": "object",
  "required": [
    "seed",
    "development",
    "acceptance"
  ],
  "properties": {
    "seed": {
      "type": "integer"
    },
    "development": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "$ref": "#/$defs/developmentPaper"
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/acceptancePaper"
      }
    }
  },
  "additionalProperties": false,
  "$comment": "The x-semantic-invariants below are not enforced by JSON Schema; Dataset.from_record enforces them.",
  "x-semantic-invariants": [
    "item_key values are unique within and across the paper-group arrays",
    "each nested case item_key equals its containing paper-group item_key",
    "case_id values are globally unique",
    "each paper contains at most one case of each case_type"
  ],
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "pattern": "\\S"
    },
    "evalCase": {
      "type": "object",
      "required": [
        "case_id",
        "case_type",
        "split",
        "visible_context",
        "fact_packet",
        "reference_continuation",
        "item_key",
        "attachment_key",
        "content_hash"
      ],
      "properties": {
        "case_id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "case_type": {
          "enum": [
            "SCC",
            "FGCC"
          ]
        },
        "split": {
          "enum": [
            "development",
            "acceptance"
          ]
        },
        "visible_context": {
          "$ref": "#/$defs/nonBlankString"
        },
        "fact_packet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlankString"
          },
          "uniqueItems": true
        },
        "reference_continuation": {
          "$ref": "#/$defs/nonBlankString"
        },
        "item_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "attachment_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "content_hash": {
          "$ref": "#/$defs/nonBlankString"
        },
        "retrieval_handles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/nonBlankString"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "case_type": {
                "const": "SCC"
              }
            },
            "required": [
              "case_type"
            ]
          },
          "then": {
            "properties": {
              "fact_packet": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "case_type": {
                "const": "FGCC"
              }
            },
            "required": [
              "case_type"
            ]
          },
          "then": {
            "properties": {
              "fact_packet": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "developmentPaper": {
      "type": "object",
      "required": [
        "item_key",
        "cases"
      ],
      "properties": {
        "item_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/evalCase"
              },
              {
                "properties": {
                  "split": {
                    "const": "development"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "acceptancePaper": {
      "type": "object",
      "required": [
        "item_key",
        "cases"
      ],
      "properties": {
        "item_key": {
          "$ref": "#/$defs/nonBlankString"
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/evalCase"
              },
              {
                "properties": {
                  "split": {
                    "const": "acceptance"
                  }
                }
              }
            ]
          }
        }
      },
      "additionalProperties": false
    }
  }
}
