#!/bin/bash
#PBS -N vasp-wannier-prerun
#PBS -q manycores
#PBS -l nodes=1:ppn=32
#PBS -l walltime=144:00:00
#PBS -S /bin/bash
#PBS -V

RUN_TAG="${RUN_TAG:-}"
TASK_ROOT="${PBS_O_WORKDIR:-}"
RUN_DIR="$TASK_ROOT/$RUN_TAG"
INPUTS_DIR="$TASK_ROOT/inputs"
OUTPUT_FILE="$RUN_DIR/output"
WORK_DIR="$RUN_DIR/wannier"
NP=$(wc -l < "$PBS_NODEFILE")

[ -n "$TASK_ROOT" ] && [ -d "$TASK_ROOT" ] && [ -n "$RUN_TAG" ] || exit 1
[ -d "$INPUTS_DIR" ] || exit 1
: > "$OUTPUT_FILE"
mkdir -p "$WORK_DIR" || exit 1
cp -f "$INPUTS_DIR/INCAR" "$INPUTS_DIR/POSCAR" "$INPUTS_DIR/KPOINTS" "$INPUTS_DIR/CHGCAR" "$INPUTS_DIR/WAVECAR" "$WORK_DIR/" || exit 1
cd "$WORK_DIR" || exit 1
[ -f "$INPUTS_DIR/cluster-env.sh" ] || exit 1
source "$INPUTS_DIR/cluster-env.sh" || exit 1
[ -x "$VASP_EXE" ] && [ -x "$VASPKIT_EXE" ] || exit 1
(echo 103) | "$VASPKIT_EXE" >> vaspkit_output 2>&1 || exit 1
mpirun -machinefile "$PBS_NODEFILE" -np "$NP" "$VASP_EXE" >> "$OUTPUT_FILE" 2>&1 || exit 1
cp -f wannier90.win wannier90.1.win || exit 1
cp -f wannier90.win wannier90.2.win || exit 1
[ -s wannier90.1.win ] && [ -s wannier90.2.win ] || {
    echo "missing or empty spin-resolved Wannier pre-run inputs" >> "$OUTPUT_FILE"
    exit 1
}
echo "handoff complete: spin-resolved Wannier pre-run inputs" >> "$OUTPUT_FILE"
