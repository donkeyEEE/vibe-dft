#!/bin/bash
#PBS -N vasp-wannier-prerun
#PBS -q manycores
#PBS -l nodes=1:ppn=32
#PBS -l walltime=144:00:00
#PBS -S /bin/bash
#PBS -V

RUN_DIR="${PBS_O_WORKDIR:?missing PBS work directory}"
INPUTS_DIR="$RUN_DIR/inputs"
OUTPUTS_DIR="$RUN_DIR/outputs"
LOGS_DIR="$RUN_DIR/logs"
test -d "$INPUTS_DIR" && test -d "$OUTPUTS_DIR" && test -d "$LOGS_DIR" || exit 1
source "$INPUTS_DIR/cluster-env.sh" || exit 1
cd "$OUTPUTS_DIR" || exit 1

test -z "$(find . -mindepth 1 -maxdepth 1 -print -quit)" || { echo "outputs directory is not empty" >&2; exit 1; }
for file in INCAR POSCAR KPOINTS POTCAR CHGCAR WAVECAR; do test -s "$INPUTS_DIR/$file" || { echo "missing Wannier pre-run input: $file" >&2; exit 1; }; done
test -x "$VASP_EXE" && command -v mpirun >/dev/null 2>&1 || exit 1
test -s "${PBS_NODEFILE:?missing PBS node file}" || exit 1
cp -- "$INPUTS_DIR/INCAR" "$INPUTS_DIR/POSCAR" "$INPUTS_DIR/KPOINTS" "$INPUTS_DIR/POTCAR" "$INPUTS_DIR/CHGCAR" "$INPUTS_DIR/WAVECAR" . || exit 1
ulimit -s unlimited
mpirun -machinefile "$PBS_NODEFILE" -np "$(wc -l < "$PBS_NODEFILE")" "$VASP_EXE" > "$LOGS_DIR/vasp-wannier-prerun.log" 2>&1 || exit 1
for spin in 1 2; do for suffix in amn mmn eig win; do test -s "wannier90.$spin.$suffix" || { echo "missing spin-resolved Wannier pre-run output: wannier90.$spin.$suffix" >&2; exit 1; }; done; done
