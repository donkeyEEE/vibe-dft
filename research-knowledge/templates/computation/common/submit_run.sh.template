#!/bin/bash

RUN_TAG="$1"
MODE="${2:-refuse}"
TASK_ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)" || exit 1
RUN_DIR="$TASK_ROOT/$RUN_TAG"
INPUTS_DIR="$TASK_ROOT/inputs"
PREPARE_SCRIPT="$INPUTS_DIR/prepare_run.sh"
VALIDATE_SCRIPT="$INPUTS_DIR/validate_run.sh"
PBS_SCRIPT="$INPUTS_DIR/run_METHOD.pbs"

[ -n "$RUN_TAG" ] || { echo "usage: $0 <run-tag>" >&2; exit 1; }
[ -d "$INPUTS_DIR" ] || { echo "missing task inputs: $INPUTS_DIR" >&2; exit 1; }
case "$MODE" in
    refuse|reuse|overwrite) ;;
    *) echo "usage: $0 <run-tag> [reuse|overwrite]" >&2; exit 1 ;;
esac
if [ -e "$RUN_DIR" ]; then
    case "$MODE" in
        refuse) echo "run directory exists; use reuse or overwrite explicitly: $RUN_DIR" >&2; exit 1 ;;
        reuse) ;;
        overwrite)
            [ "${ALLOW_OVERWRITE:-}" = "1" ] || { echo "overwrite requires ALLOW_OVERWRITE=1" >&2; exit 1; }
            rm -rf -- "$RUN_DIR" || exit 1
            ;;
    esac
fi
mkdir -p "$RUN_DIR" || exit 1
[ -f "$PREPARE_SCRIPT" ] || { echo "missing preparation script: $PREPARE_SCRIPT" >&2; exit 1; }
[ -f "$VALIDATE_SCRIPT" ] || { echo "missing validation script: $VALIDATE_SCRIPT" >&2; exit 1; }
[ -f "$PBS_SCRIPT" ] || { echo "missing PBS script: $PBS_SCRIPT" >&2; exit 1; }

source /etc/profile || exit 1
command -v qsub >/dev/null 2>&1 || { echo "qsub is unavailable" >&2; exit 1; }
bash "$PREPARE_SCRIPT" "$RUN_TAG" || exit 1
bash "$VALIDATE_SCRIPT" "$RUN_TAG" || exit 1
cd "$TASK_ROOT" || exit 1
qsub -v "RUN_TAG=$RUN_TAG" "$PBS_SCRIPT" || exit 1
