#!/bin/bash
#PBS -N wannier90
#PBS -q manycores
#PBS -l nodes=1:ppn=32
#PBS -l walltime=144:00:00

RUN_TAG="${RUN_TAG:-}"
TASK_ROOT="${PBS_O_WORKDIR:-}"
RUN_DIR="$TASK_ROOT/$RUN_TAG"
INPUTS_DIR="$TASK_ROOT/inputs"
OUTPUT_FILE="$RUN_DIR/output"
WORK_DIR="$RUN_DIR/wannier"
BAND_DIR="$INPUTS_DIR/band"
PLOT_EMIN="${PLOT_EMIN:-}"
PLOT_EMAX="${PLOT_EMAX:-}"

[ -n "$TASK_ROOT" ] && [ -d "$TASK_ROOT" ] && [ -n "$RUN_TAG" ] || exit 1
[ -d "$INPUTS_DIR" ] || exit 1
: > "$OUTPUT_FILE"
[ -n "$PLOT_EMIN" ] && [ -n "$PLOT_EMAX" ] || { echo "set PLOT_EMIN and PLOT_EMAX" >> "$OUTPUT_FILE"; exit 1; }
[ -f "$INPUTS_DIR/wannier-run.env" ] || { echo "missing run input wannier-run.env" >> "$OUTPUT_FILE"; exit 1; }
[ -f "$INPUTS_DIR/cluster-env.sh" ] || { echo "missing sibling cluster-env.sh" >> "$OUTPUT_FILE"; exit 1; }
source "$INPUTS_DIR/cluster-env.sh" || exit 1
WANNIER90_MPI_LAUNCHER="${WANNIER90_MPI_LAUNCHER:-mpirun}"
command -v "$WANNIER90_MPI_LAUNCHER" >/dev/null 2>&1 || { echo "missing Wannier90 MPI launcher: $WANNIER90_MPI_LAUNCHER" >> "$OUTPUT_FILE"; exit 1; }
[ -x "$WANNIER90_EXE" ] || { echo "invalid WANNIER90_EXE" >> "$OUTPUT_FILE"; exit 1; }
source "$INPUTS_DIR/wannier-run.env"
for variable in UP_DIS_WIN_MIN UP_DIS_WIN_MAX UP_DIS_FROZ_MIN UP_DIS_FROZ_MAX DN_DIS_WIN_MIN DN_DIS_WIN_MAX DN_DIS_FROZ_MIN DN_DIS_FROZ_MAX; do
    eval "value=\${$variable:-}"
    [ -n "$value" ] || { echo "set $variable in inputs/wannier-run.env" >> "$OUTPUT_FILE"; exit 1; }
done

set_win_value() {
    local file="$1"
    local key="$2"
    local value="$3"
    if grep -Eq "^[[:space:]]*${key}[[:space:]]*=" "$file"; then
        sed -i -E "s|^[[:space:]]*${key}[[:space:]]*=.*|${key} = ${value}|" "$file" || exit 1
    else
        printf '\n%s = %s\n' "$key" "$value" >> "$file" || exit 1
    fi
}
mkdir -p "$WORK_DIR" || exit 1
[ -f "$INPUTS_DIR/plot_wannier_fit_up.py" ] || { echo "missing staged plot helper: plot_wannier_fit_up.py" >> "$OUTPUT_FILE"; exit 1; }
[ -f "$INPUTS_DIR/plot_wannier_fit_dn.py" ] || { echo "missing staged plot helper: plot_wannier_fit_dn.py" >> "$OUTPUT_FILE"; exit 1; }
cp -f "$INPUTS_DIR/plot_wannier_fit_up.py" "$WORK_DIR/" || exit 1
cp -f "$INPUTS_DIR/plot_wannier_fit_dn.py" "$WORK_DIR/" || exit 1
cp -f "$INPUTS_DIR"/wannier90.?.win "$INPUTS_DIR"/wannier90.?.amn "$INPUTS_DIR"/wannier90.?.mmn "$INPUTS_DIR"/wannier90.?.eig "$WORK_DIR/" || exit 1
cp -f "$BAND_DIR/bandrange_spin0.dat" "$BAND_DIR/bandrange_spin1.dat" \
    "$BAND_DIR/REFORMATTED_BAND_UP.dat" "$BAND_DIR/REFORMATTED_BAND_DW.dat" \
    "$BAND_DIR/DOSCAR" "$WORK_DIR/" || exit 1
cd "$WORK_DIR" || exit 1

# Remove only products that are regenerated by this script. Keep .win, .amn,
# .mmn, and .eig VASP-to-Wannier interface files; TB2J handoff products must
# be recreated so a failed rerun cannot leave a stale one-spin model behind.
rm -f *.wout *.werr *.band *.band.dat *_band.dat *.chk *.xmgrace *.gnu \
    *_hr.dat *_centres.xyz band_structure-up.png band_structure-dn.png

set_win_value wannier90.1.win dis_win_min "$UP_DIS_WIN_MIN"
set_win_value wannier90.1.win dis_win_max "$UP_DIS_WIN_MAX"
set_win_value wannier90.1.win dis_froz_min "$UP_DIS_FROZ_MIN"
set_win_value wannier90.1.win dis_froz_max "$UP_DIS_FROZ_MAX"
set_win_value wannier90.1.win write_xyz true
set_win_value wannier90.2.win dis_win_min "$DN_DIS_WIN_MIN"
set_win_value wannier90.2.win dis_win_max "$DN_DIS_WIN_MAX"
set_win_value wannier90.2.win dis_froz_min "$DN_DIS_FROZ_MIN"
set_win_value wannier90.2.win dis_froz_max "$DN_DIS_FROZ_MAX"
set_win_value wannier90.2.win write_xyz true

"$WANNIER90_MPI_LAUNCHER" "$WANNIER90_EXE" wannier90.1 >> "$OUTPUT_FILE" 2>&1 || exit 1
"$WANNIER90_MPI_LAUNCHER" "$WANNIER90_EXE" wannier90.2 >> "$OUTPUT_FILE" 2>&1 || exit 1
[ -s wannier90.1_hr.dat ] && [ -s wannier90.2_hr.dat ] || { echo "missing nonempty spin-resolved *_hr.dat" >> "$OUTPUT_FILE"; exit 1; }
[ -s wannier90.1_centres.xyz ] && [ -s wannier90.2_centres.xyz ] || { echo "missing nonempty spin-resolved *_centres.xyz; verify write_xyz = true" >> "$OUTPUT_FILE"; exit 1; }
[ -s wannier90.1_band.dat ] && [ -s wannier90.2_band.dat ] || { echo "missing nonempty spin-resolved Wannier band data" >> "$OUTPUT_FILE"; exit 1; }
python3 plot_wannier_fit_up.py --emin "$PLOT_EMIN" --emax "$PLOT_EMAX" --vest-band REFORMATTED_BAND_UP.dat --output band_structure-up.png >> "$OUTPUT_FILE" 2>&1 || exit 1
python3 plot_wannier_fit_dn.py --emin "$PLOT_EMIN" --emax "$PLOT_EMAX" --vest-band REFORMATTED_BAND_DW.dat --output band_structure-dn.png >> "$OUTPUT_FILE" 2>&1 || exit 1
[ -s band_structure-up.png ] && [ -s band_structure-dn.png ] || { echo "missing nonempty spin-resolved Wannier fit plots" >> "$OUTPUT_FILE"; exit 1; }
echo "handoff complete: spin-resolved Wannier models and fit plots" >> "$OUTPUT_FILE"
