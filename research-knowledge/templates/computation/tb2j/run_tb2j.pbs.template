#!/bin/bash
#PBS -N tb2j
#PBS -q manycores
#PBS -l nodes=1:ppn=32
#PBS -l walltime=144:00:00

RUN_TAG="${RUN_TAG:-}"
TASK_ROOT="${PBS_O_WORKDIR:-}"
RUN_DIR="$TASK_ROOT/$RUN_TAG"
INPUTS_DIR="$TASK_ROOT/inputs"
OUTPUT_FILE="$RUN_DIR/output"

[ -n "$TASK_ROOT" ] && [ -d "$TASK_ROOT" ] && [ -n "$RUN_TAG" ] || exit 1
[ -d "$INPUTS_DIR" ] || exit 1
cd "$RUN_DIR" || exit 1
: > "$OUTPUT_FILE"
[ -f "$INPUTS_DIR/cluster-env.sh" ] || exit 1
source "$INPUTS_DIR/cluster-env.sh" || exit 1
command -v conda >/dev/null 2>&1 && [ -n "$TB2J_CONDA_ENV" ] || exit 1

cp -f "$INPUTS_DIR/POSCAR" POSCAR || exit 1
cp -f "$INPUTS_DIR/OUTCAR" OUTCAR || exit 1
for file in \
    wannier90.1_hr.dat wannier90.2_hr.dat \
    wannier90.1_centres.xyz wannier90.2_centres.xyz; do
    [ -f "$INPUTS_DIR/$file" ] || { echo "missing TB2J handoff: inputs/$file" >> "$OUTPUT_FILE"; exit 1; }
done
cp -f "$INPUTS_DIR/wannier90.1_hr.dat" "$INPUTS_DIR/wannier90.2_hr.dat" \
    "$INPUTS_DIR/wannier90.1_centres.xyz" "$INPUTS_DIR/wannier90.2_centres.xyz" . || exit 1
SCF_EFERMI=$(awk '/E-fermi[[:space:]]*:/ { value=$3 } END { print value }' OUTCAR) || exit 1
conda run -n "$TB2J_CONDA_ENV" wann2J.py --posfile POSCAR --rcut "__TB2J_RCUT__" --efermi "$SCF_EFERMI" \
    --kmesh __TB2J_KMESH__ --elements "__TB2J_ELEMENTS__" \
    --prefix_up wannier90.1 --prefix_down wannier90.2 \
    --emin "__TB2J_EMIN__" --emax "__TB2J_EMAX__" >> "$OUTPUT_FILE" 2>&1 || exit 1
[ -s TB2J_results/exchange.out ] && [ -s TB2J_results/Vampire/vampire.UCF ] && [ -s TB2J_results/Vampire/vampire.mat ] || {
    echo "missing or empty TB2J exchange and VAMPIRE handoff outputs" >> "$OUTPUT_FILE"
    exit 1
}
echo "handoff complete: TB2J exchange and VAMPIRE models" >> "$OUTPUT_FILE"
